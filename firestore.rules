rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validLanguage(data) {
      return !("language" in data) || data.language in ["pt", "en", "es"];
    }

    function protectedUserFields() {
      return [
        "vip",
        "vipActive",
        "isVip",
        "vip_enabled",
        "vipUntil",
        "vip_until",
        "vipExpiresAt",
        "vip_expires_at",
        "subscriptionStatus",
        "stripeCustomerId",
        "stripeSubscriptionId",
        "unlockedCycles",
        "unlockedDays",
        "coinUnlockedDays",
        "coins"
      ];
    }

    // Conteudo do calendario precisa funcionar antes e depois do login.
    match /cycleDays/{dayId} {
      allow read: if true;
      allow write: if false;
    }

    // Configuracoes publicas do app, como versao minima obrigatoria.
    match /appConfig/{configId} {
      allow read: if configId == "android";
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if owns(uid);

      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && (!("vip" in request.resource.data) || request.resource.data.vip == false)
        && (!("coins" in request.resource.data) || request.resource.data.coins == 0)
        && (!("unlockedCycles" in request.resource.data)
          || request.resource.data.unlockedCycles == 0)
        && validLanguage(request.resource.data);

      allow update: if owns(uid)
        && validLanguage(request.resource.data)
        && !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(protectedUserFields());

      allow delete: if owns(uid);

      match /habits/{habitId} {
        allow read, create, update, delete: if owns(uid);
      }

      match /goals/{goalId} {
        allow read, create, update, delete: if owns(uid);
      }

      match /dailyProgress/{dayId} {
        allow read: if owns(uid);

        allow create, update: if owns(uid)
          && request.resource.data.keys().hasOnly([
            "dateKey",
            "waterDone",
            "workoutDone",
            "mealsDone",
            "checkInDone",
            "updatedAt"
          ])
          && request.resource.data.dateKey == dayId
          && request.resource.data.updatedAt == request.time
          && (!("waterDone" in request.resource.data)
            || request.resource.data.waterDone is bool)
          && (!("workoutDone" in request.resource.data)
            || request.resource.data.workoutDone is bool)
          && (!("mealsDone" in request.resource.data)
            || request.resource.data.mealsDone is bool)
          && (!("checkInDone" in request.resource.data)
            || request.resource.data.checkInDone is bool);

        allow delete: if owns(uid);
      }

    }

    match /users/{uid}/coinTransactions/{transactionId} {
      allow read: if owns(uid);
      allow write: if false;
    }

    match /users/{uid}/walletDaily/{dayId} {
      allow read, write: if false;
    }

    match /users/{uid}/measurements/{measurementId} {
      allow read: if owns(uid);

      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          "weightKg",
          "waistCm",
          "abdomenCm",
          "hipCm",
          "createdAt"
        ])
        && request.resource.data.weightKg is number
        && request.resource.data.weightKg >= 25
        && request.resource.data.weightKg <= 350
        && request.resource.data.createdAt == request.time
        && (!("waistCm" in request.resource.data)
          || (request.resource.data.waistCm is number
            && request.resource.data.waistCm >= 30
            && request.resource.data.waistCm <= 250))
        && (!("abdomenCm" in request.resource.data)
          || (request.resource.data.abdomenCm is number
            && request.resource.data.abdomenCm >= 30
            && request.resource.data.abdomenCm <= 250))
        && (!("hipCm" in request.resource.data)
          || (request.resource.data.hipCm is number
            && request.resource.data.hipCm >= 30
            && request.resource.data.hipCm <= 250));

      allow update: if false;
      allow delete: if owns(uid);
    }

    // Eventos Stripe e demais colecoes administrativas sao somente servidor.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
